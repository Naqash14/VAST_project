{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python3 -m venv /app/venv && /app/venv/bin/pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "/app/venv/bin/gunicorn run:app --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
